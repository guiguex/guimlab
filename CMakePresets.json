{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CUDA_STANDARD": "20",
        "GUIM_CUDA_ARCH": "86",
        "GUIM_BUILD_STUDIO": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (Max Performance & Fast Math)",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GUIM_ENABLE_ASAN": "OFF"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Developer Debug with Symbols",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GUIM_ENABLE_ASAN": "OFF"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Host Address & UB Sanitizer",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GUIM_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "bench",
      "inherits": "base",
      "displayName": "Benchmark & Optimization Suite",
      "binaryDir": "${sourceDir}/build/bench",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GUIM_BUILD_STUDIO": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "bench",
      "configurePreset": "bench"
    }
  ],
  "testPresets": [
    {
      "name": "all-tests",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
